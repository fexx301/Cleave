# Copy to .env.local (gitignored) OR paste your Firebase config directly in the in-app Settings drawer.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Firebase App Check (Fraud Defense / reCAPTCHA Enterprise site key for deployed domains)
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=

# Default cloud model on Gemini Developer API (Spark free tier verified: gemini-3.5-flash-lite)
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
